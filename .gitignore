# Credentials. .env.example is the template; the real one never leaves the machine.
.env

# The virtualenv (550 MB) and everything that rebuilds from uv.lock.
.venv/
__pycache__/
*.pyc
*.pyo

# Scratch: SWE-bench checkouts the SDK workspace makes, and its own event store.
# Regenerated on every run, ~100 MB.
.cache/

# Instance images kept as gzipped `docker save`, so each is pulled from the registry
# once ever. ~1 GB each, ~15 GB for the set -- data, and reproducible from the registry
# given hours. See openhands_f2p/image_cache.py; F2P_IMAGE_CACHE moves it.
image-cache/

# The SWE-bench Verified dump, 8 MB of someone else's data and a download rather
# than a source file. See openhands_f2p/dataset.py for how to fetch it.
data/

# Raw prompt and response bytes, one file per model call. 43 MB across 26 instances in
# out/, and 143 MB of the 159 MB in out_compare_repo_search/ -- the least-read artefact in a run
# directory by a wide margin. The trajectory, the flow log and the tool log carry the
# same events in a form people actually open.
# Set LLM_LOG_COMPLETIONS=1 and rerun to regenerate them locally.
#
# Matched under any run directory, not just out/: a series writes to its own root
# (out_compare_repo_search/<configuration>/<instance>/), and the previous `out/*/completions/`
# silently stopped applying the moment a run went anywhere else.
out*/**/completions/

.DS_Store
.ruff_cache/
