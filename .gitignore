# Credentials. .env.example is the template; the real one never leaves the machine.
.env

# The virtualenv (550 MB) and everything that rebuilds from uv.lock.
.venv/
__pycache__/
*.pyc
*.pyo

# Scratch: SWE-bench checkouts the SDK workspace makes, and its own event store.
# Regenerated on every run, ~100 MB.
.cache/

# The SWE-bench Verified dump, 8 MB of someone else's data and a download rather
# than a source file. See openhands_f2p/dataset.py for how to fetch it.
data/

# Raw prompt and response bytes, one file per model call: 43 MB across 26 instances,
# which is seven eighths of out/ for the least-read artefact in it. The trajectory,
# the flow log and the tool log carry the same events in a form people actually open.
# Set LLM_LOG_COMPLETIONS=1 and rerun to regenerate them locally.
out/*/completions/
out_compare_coverage/*/*/completions/

.DS_Store
.ruff_cache/
