# Copy to .env and fill in. .env is git-ignored; this file is the template.

# --- the model the agent runs on -------------------------------------------------
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-gateway/v1
# Behind a LiteLLM gateway the model needs the litellm_proxy/ prefix, or litellm
# strips the provider and the gateway answers 400.
LLM_MODEL=litellm_proxy/gpt-5-mini
# Set only if the endpoint needs an HTTP proxy. Handed to litellm as an explicit
# client, so it never enters the environment the container inherits.
LLM_PROXY=
# 'chat', not 'auto'. Auto resolves gpt-5-mini to the Responses API, which hangs
# against some gateways for the full timeout.
LLM_API_MODE=chat
# Seconds. litellm's own default of 300 is too low once test logs are in context.
LLM_TIMEOUT=600
# Reasoning models spend this before emitting anything; too low returns empty content
# with finish_reason=length.
LLM_MAX_OUTPUT_TOKENS=32000
# How long to wait out a rate-limited gateway. The SDK's defaults (5 attempts, 64s)
# give up after about three minutes, which is not enough under --parallel.
LLM_NUM_RETRIES=10
LLM_RETRY_MAX_WAIT=120

# --- the final comparison against the maintainer's test --------------------------
# Deliberately a stronger model than the agent's: one call per instance, and it is a
# judgement rather than a search.
LLM_JUDGE_MODEL=litellm_proxy/gpt-5.5
LLM_JUDGE_TIMEOUT=180

# --- the harness ------------------------------------------------------------------
# PRs at once, as separate processes. Higher is not better: 30 exceeded the Docker
# VM's disk and rate-limited the gateway into failing four instances outright.
F2P_MAX_PARALLEL=5
# Path to the SWE-bench Verified dump, if it is not at data/swebench_verified.json.
F2P_DATASET=
# Ceiling on one child process, seconds. A wedged child used to hold the parent open
# indefinitely.
F2P_CHILD_TIMEOUT=7200
# Comma-separated prompt pieces to omit, for arm comparisons. See prompts/README.md.
F2P_PROMPT_SKIP=

# The SDK prints a banner on import; nothing in it says whether the run worked.
OPENHANDS_SUPPRESS_BANNER=1

# The interpreter the pipeline arm builds its virtualenvs with. Unused by the
# agent arm, which runs everything inside the container.
F2P_PYTHON=
