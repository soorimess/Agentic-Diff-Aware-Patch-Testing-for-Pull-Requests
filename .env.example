# Copy to .env and fill in. .env is git-ignored; this file is the template.

# --- credentials and routing, which are the only things that have to live here ----
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-gateway/v1
# Set only if the endpoint needs an HTTP proxy. Handed to litellm as an explicit
# client, so it never enters the environment the container inherits.
LLM_PROXY=

# --- which model answers ----------------------------------------------------------
# Not here. `--model` and `--judge-model` on the command line, and `models.json` at
# the project root for everything a model needs: API mode, token ceiling, timeout,
# retry policy, which credentials to look for. `python -m openhands_f2p.models`
# prints the resolved table.
#
# Precedence: CLI flag, then models.json, then the FALLBACK_ variables below, then
# the built-in defaults. The registry sits above the environment on purpose -- a
# variable is global and a profile is per-model, so while the variable won,
# LLM_TIMEOUT=600 here silently overrode the 900 that gpt-5.5's profile asks for and
# no profile could be trusted to mean anything.

# --- fallbacks, used only where models.json says nothing --------------------------
# Every one of these is optional. A profile that names the field wins; these fill the
# gap for a model with no entry of its own, which is how a new model can be tried
# without editing the registry first. Put a value you intend to keep in models.json
# instead, with a note saying why.
FALLBACK_LLM_MODEL=gpt-5-mini
FALLBACK_LLM_API_MODE=chat            # 'auto' resolved gpt-5-mini to an endpoint that hung
FALLBACK_LLM_TIMEOUT=600              # seconds; litellm's own default of 300 is too low
FALLBACK_LLM_MAX_OUTPUT_TOKENS=32000  # too low returns empty content, finish_reason=length
FALLBACK_LLM_NUM_RETRIES=10           # the SDK's 5 gives up after ~3 minutes under --parallel
FALLBACK_LLM_RETRY_MAX_WAIT=120

# --- the final comparison against the maintainer's test --------------------------
# Deliberately a stronger model than the agent's: one call per instance, and it is a
# judgement rather than a search. Lives in models.json as `default_judge` and
# `default_judge_timeout`; these are the fallbacks if that file omits them.
FALLBACK_LLM_JUDGE_MODEL=gpt-5.5
FALLBACK_LLM_JUDGE_TIMEOUT=180

# --- the harness ------------------------------------------------------------------
# PRs at once, as separate processes. Higher is not better: 30 exceeded the Docker
# VM's disk and rate-limited the gateway into failing four instances outright.
F2P_MAX_PARALLEL=5
# Path to the SWE-bench Verified dump, if it is not at data/swebench_verified.json.
F2P_DATASET=
# A model registry somewhere other than models.json at the project root.
F2P_MODELS_FILE=
# Ceiling on one child process, seconds. A wedged child used to hold the parent open
# indefinitely.
F2P_CHILD_TIMEOUT=7200
# Comma-separated prompt pieces to omit, for arm comparisons. See prompts/README.md.
F2P_PROMPT_SKIP=

# The SDK prints a banner on import; nothing in it says whether the run worked.
OPENHANDS_SUPPRESS_BANNER=1

# The interpreter the pipeline arm builds its virtualenvs with. Unused by the
# agent arm, which runs everything inside the container.
F2P_PYTHON=
